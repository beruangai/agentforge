{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@beruangai/agentforge"],
    "rootDir": ".",
    "paths": {
      ":beruangai/agentforge-temporal-workflow": [
        "./packages/temporal-workflow/src/index.ts"
      ],
      ":beruangai/agentforge-claude-sandbox": [
        "./packages/claude-sandbox/src/index.ts"
      ],
      ":beruangai/agentforge-mcp-gateway": [
        "./packages/mcp-gateway/src/index.ts"
      ]
    }
  }
}
