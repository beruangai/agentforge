{
  "extends": "@tsconfig/node26/tsconfig.json",
  "compilerOptions": {
    "customConditions": [
      "@beruangai/source"
    ],
    "isolatedModules": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "strict": true,
    "paths": {
      "@beruangai/common-constructs": [
        "./packages/common/constructs/src/index.ts"
      ],
      "@beruangai/golden-kata-infra": [
        "./packages/examples/golden-kata-infra/src/index.ts"
      ],
      "@beruangai/smoke-coverage-infra": [
        "./packages/examples/smoke-coverage-infra/src/index.ts"
      ]
    },
    "rootDir": ".",
    "composite": true,
    "emitDeclarationOnly": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true
  }
}
