{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassTheSpikeExecutionRoleToAgentCoreOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::913756569129:role/agentforge-spike-agentcore-execution",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "bedrock-agentcore.amazonaws.com"
        }
      }
    }
  ]
}
