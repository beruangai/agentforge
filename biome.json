                "patterns": [
                  {
                    "group": [
                      "**/framework/**",
                      "#framework/**",
                      "!**/framework/registry.ts",
                      "!#framework/registry.ts",
                      "@anthropic-ai/**",
                      "@strands-agents/**"
                    ],
                    "message": "Shared modules never import a framework or its SDK; a framework plugs into the seam, and the plugin reaches frameworks only through the registry (ADR 0021)."
                  }
                ]
              }
            }
          }
        }
      }
    },
