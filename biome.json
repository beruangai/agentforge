{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "root": true,
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "all"
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "single"
    },
    "linter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredDependencies": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/out-tsc",
      "!**/test-output",
      "!**/rolldown.config.*.*js",
      "!**/node_modules",
      "!**/.nx",
      "!**/.venv",
      "!**/.grit",
      "!**/*.css",
      "!**/*.gen.*",
      "!**/generated",
      "!**/tsconfig*.json"
    ]
  },
  "overrides": [
    {
      "includes": [
        "**/*.config.{ts,mts,cts,js,mjs,cjs}",
        "**/*.{spec,test}.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "**/*.stories.{ts,tsx}"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/agentforge/src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/server/**",
                      "**/client/**",
                      "**/infra/**",
                      "@anthropic-ai/claude-agent-sdk",
                      "@a2a-js/**",
                      "@temporalio/**",
                      "aws-cdk-lib",
                      "aws-cdk-lib/**"
                    ],
                    "message": "core is shared by every seam and imports none of them, and never a platform SDK (ARCHITECTURE.md \u00a71, \u00a710)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/agentforge/src/server/runtime/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/harness/**",
                      "@anthropic-ai/claude-agent-sdk"
                    ],
                    "message": "Layer 1 never imports layer 2, and knows nothing of the Agent SDK; they share only core (ARCHITECTURE.md \u00a71)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/agentforge/src/server/harness/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/runtime/**", "@a2a-js/**", "express"],
                    "message": "Layer 2 never imports layer 1, and knows nothing of A2A or the container; they share only core (ARCHITECTURE.md \u00a71)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/agentforge/src/client/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/server/**",
                      "**/infra/**",
                      "@anthropic-ai/claude-agent-sdk"
                    ],
                    "message": "The client runs in a caller and must never reach the container's code or the Agent SDK (ARCHITECTURE.md \u00a710)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/agentforge/src/infra/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/server/**",
                      "**/client/**",
                      "@anthropic-ai/claude-agent-sdk"
                    ],
                    "message": "The constructs run in a CDK application and reach nothing that runs in the container or a caller (ARCHITECTURE.md \u00a710)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
