                      "../../../server/**",
                      "../../../../server/**",
                      "../../../client/**",
                      "../../../../client/**",
                      "../../../infra/**",
                      "../../../../infra/**"
                    ],
                    "message": "Inside a framework the layer rules hold: each part imports only its framework's core/ and the shared modules its layer may (ADR 0021, ARCHITECTURE.md §1, §8)."
                  },
                  {
                    "group": ["**/claude/**", "**/strands/**"],
                    "message": "Frameworks never import each other (ADR 0021)."
                  },
                  {
                    "group": ["@strands-agents/**"],
                    "message": "Only the strands framework imports the Strands SDK (ADR 0021)."
