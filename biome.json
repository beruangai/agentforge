                  {
                    "group": [
                      "**/server/**",
                      "**/client/**"
                    ],
                    "message": "The constructs run in a CDK application and reach nothing that runs in the container or a caller (ARCHITECTURE.md \u00a78)."
                  },
                  {
                    "group": [
                      "**/framework/**",
                      "#framework/**",
                      "@anthropic-ai/**",
                      "@strands-agents/**"
