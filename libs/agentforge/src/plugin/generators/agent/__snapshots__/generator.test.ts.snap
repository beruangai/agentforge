exports[`agent > generates the agent's folder, record, image, entries and construct > targets 1`] = `
{
  "assemble": {
    "dependsOn": [
      "image-writer",
    ],
    "executor": "nx:noop",
  },
  "image": {
    "cache": false,
    "dependsOn": [
      "lock",
      "image-agentforge",
    ],
    "executor": "@beruangai/agentforge:image",
    "options": {
      "layer": "base",
    },
  },
  "image-agentforge": {
    "cache": false,
    "dependsOn": [
      "^bundle",
    ],
    "executor": "@beruangai/agentforge:image",
    "options": {
      "layer": "agentforge",
    },
  },
  "image-writer": {
    "cache": false,
    "dependsOn": [
      "lock-writer",
      "image",
    ],
    "executor": "@beruangai/agentforge:image",
    "options": {
      "layer": "agents/writer",
    },
  },
  "lock": {
    "cache": true,
    "dependsOn": [
      "^bundle",
    ],
    "executor": "@beruangai/agentforge:lock",
    "inputs": [
      "{projectRoot}/base/agentic/package.json",
      {
        "dependentTasksOutputFiles": "**/package.json",
        "transitive": true,
      },
      {
        "dependentTasksOutputFiles": "**/bun.lock",
        "transitive": true,
      },
      {
        "runtime": "bun --version",
      },
    ],
    "options": {
      "layer": "base",
    },
    "outputs": [
      "{projectRoot}/base/agentic/bun.lock",
    ],
  },
  "lock-writer": {
    "cache": true,
    "dependsOn": [
      "lock",
    ],
    "executor": "@beruangai/agentforge:lock",
    "inputs": [
      "{projectRoot}/base/agentic/package.json",
      "{projectRoot}/agents/writer/agent/package.json",
      {
        "dependentTasksOutputFiles": "**/package.json",
        "transitive": true,
      },
      {
        "dependentTasksOutputFiles": "**/bun.lock",
        "transitive": true,
      },
      {
        "runtime": "bun --version",
      },
    ],
    "options": {
      "layer": "agents/writer",
    },
    "outputs": [
      "{projectRoot}/agents/writer/agent/bun.lock",
    ],
  },
  "serve-writer": {
    "configurations": {
      "serve": {},
    },
    "continuous": true,
    "defaultConfiguration": "serve",
    "dependsOn": [
      "image-writer",
    ],
    "executor": "@beruangai/agentforge:serve",
    "options": {
      "agent": "writer",
    },
  },
}
`;

