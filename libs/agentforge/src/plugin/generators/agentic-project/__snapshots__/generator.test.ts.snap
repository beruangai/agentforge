"{
  "name": "@proj/golden-kata",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/examples/golden-kata",
  "projectType": "library",
  "metadata": {
    "generator": "@beruangai/agentforge:agentic-project",
    "components": [],
    "agentforge": {
      "detached": {
        "files": [],
        "targets": []
      }
    }
  },
  "targets": {
    "image-agentforge": {
      "executor": "@beruangai/agentforge:image",
      "cache": false,
      "dependsOn": ["^bundle"],
      "options": {
        "layer": "agentforge"
      }
    },
    "lock": {
      "executor": "@beruangai/agentforge:lock",
      "cache": true,
      "dependsOn": ["^bundle"],
      "inputs": [
        "{projectRoot}/base/agentic/package.json",
        {
          "dependentTasksOutputFiles": "**/package.json",
          "transitive": true
        },
        {
          "dependentTasksOutputFiles": "**/bun.lock",
          "transitive": true
        },
        {
          "runtime": "bun --version"
        }
      ],
      "outputs": ["{projectRoot}/base/agentic/bun.lock"],
      "options": {
        "layer": "base"
      }
    },
    "image": {
      "executor": "@beruangai/agentforge:image",
      "cache": false,
      "dependsOn": ["lock", "image-agentforge"],
      "options": {
        "layer": "base"
      }
    },
    "assemble": {
      "executor": "nx:noop",
      "dependsOn": []
    }
  }
}
"
`;

