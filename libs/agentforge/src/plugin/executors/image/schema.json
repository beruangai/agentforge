{
  "$schema": "https://json-schema.org/schema",
  "version": 2,
  "title": "Builds a layer of an agentic project's image chain",
  "type": "object",
  "properties": {
    "layer": {
      "type": "string",
      "description": "agentforge, agentforge-<framework>, base, or agents/<agent>",
      "pattern": "^(agentforge|agentforge-claude|base|agents/[a-z][a-z0-9-]*)$"
    },
    "buildContexts": {
      "type": "object",
      "description": "Further named build contexts for a project's layer: name to a workspace-relative directory, which its Dockerfile copies from with COPY --from=<name>",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": ["layer"],
  "additionalProperties": false
}
