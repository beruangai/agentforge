{
  "$schema": "https://json-schema.org/schema",
  "version": 2,
  "title": "Locks a layer of an agentic project's container workspace",
  "type": "object",
  "properties": {
    "layer": {
      "type": "string",
      "description": "base, or agents/<agent>",
      "pattern": "^(base|agents/[a-z][a-z0-9-]*)$"
    }
  },
  "required": ["layer"],
  "additionalProperties": false
}
