{
  "name": "@beruangai/agentforge",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/agentforge/src",
  "projectType": "library",
  "tags": [],
  "metadata": {
    "generator": "ts#project"
  },
  "targets": {
    "build": {
      "dependsOn": ["lint", "typecheck", "bundle", "test"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/integ/**/*",
        "{projectRoot}/*.mts",
        "{projectRoot}/*.ts",
        "{projectRoot}/package.json",
        "{projectRoot}/tsconfig*.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/typecheck"],
      "options": {
        "commands": ["tsc -p tsconfig.lib.json", "tsc -p tsconfig.spec.json"],
        "parallel": false,
        "cwd": "{projectRoot}"
      }
    },
    "bundle": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["production"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/bundle"],
      "options": {
        "command": "tsdown && publint run ../../dist/libs/agentforge/bundle --strict --pack npm",
        "cwd": "{projectRoot}"
      },
      "dependsOn": [
        "container-lock",
        "container-lock-claude",
        "container-lock-strands"
      ]
    },
    "pack": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["bundle"],
      "inputs": ["production"],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/pack"],
      "options": {
        "command": "mkdir -p ../pack && bun pm pack --filename ../pack/beruangai-agentforge.tgz --quiet",
        "cwd": "{workspaceRoot}/dist/{projectRoot}/bundle"
      }
    },
    "container-lock": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/container/*.ts",
        "{projectRoot}/src/plugin/container/container-workspace.ts",
        "{projectRoot}/published-manifest.ts",
        "{projectRoot}/package.json",
        "{projectRoot}/src/plugin/*.json",
        "{workspaceRoot}/package.json",
        {
          "runtime": "bun --version"
        }
      ],
      "outputs": [
        "{projectRoot}/container/workspace/package.json",
        "{projectRoot}/container/workspace/bun.lock"
      ],
      "options": {
        "command": "bun container/base-lock.ts",
        "cwd": "{projectRoot}"
      }
    },
    "container-lock-claude": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["container-lock"],
      "inputs": [
        "{projectRoot}/container/*.ts",
        "{projectRoot}/container/workspace/package.json",
        "{projectRoot}/container/workspace/bun.lock",
        "{projectRoot}/src/plugin/container/container-workspace.ts",
        "{projectRoot}/src/framework/registry.ts",
        "{projectRoot}/src/framework/claude/plugin/*.ts",
        "{projectRoot}/published-manifest.ts",
        "{projectRoot}/package.json",
        "{projectRoot}/src/plugin/*.json",
        "{workspaceRoot}/package.json",
        {
          "runtime": "bun --version"
        }
      ],
      "outputs": [
        "{projectRoot}/src/framework/claude/container/package.json",
        "{projectRoot}/src/framework/claude/container/bun.lock"
      ],
      "options": {
        "command": "bun container/framework-lock.ts claude",
        "cwd": "{projectRoot}"
      }
    },
    "container-lock-strands": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["container-lock"],
      "inputs": [
        "{projectRoot}/container/*.ts",
        "{projectRoot}/container/workspace/package.json",
        "{projectRoot}/container/workspace/bun.lock",
        "{projectRoot}/src/plugin/container/container-workspace.ts",
        "{projectRoot}/src/framework/registry.ts",
        "{projectRoot}/src/framework/strands/plugin/*.ts",
        "{projectRoot}/published-manifest.ts",
        "{projectRoot}/package.json",
        "{projectRoot}/src/plugin/*.json",
        "{workspaceRoot}/package.json",
        {
          "runtime": "bun --version"
        }
      ],
      "outputs": [
        "{projectRoot}/src/framework/strands/container/package.json",
        "{projectRoot}/src/framework/strands/container/bun.lock"
      ],
      "options": {
        "command": "bun container/framework-lock.ts strands",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*",
        "{projectRoot}/package.json",
        "{projectRoot}/vitest.config.mts",
        "{projectRoot}/tsconfig*.json",
        "{workspaceRoot}/tsconfig.base.json",
        "sharedGlobals",
        {
          "runtime": "node --version"
        },
        {
          "runtime": "bun --version"
        }
      ],
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/test"],
      "options": {
        "command": "vitest run --config vitest.config.mts",
        "cwd": "{projectRoot}"
      }
    },
    "integ": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "vitest run --config vitest.integ.mts",
        "cwd": "{projectRoot}"
      },
      "configurations": {
        "local": {
          "args": "--project=@beruangai/agentforge:integ:local"
        },
        "aws": {
          "args": "--project=@beruangai/agentforge:integ:aws*"
        },
        "model": {
          "args": "--project=@beruangai/agentforge:integ:model"
        }
      },
      "dependsOn": ["image-claude", "pack"]
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["biome"],
      "options": {
        "command": "biome check {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome check --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    },
    "image": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["bundle"],
      "options": {
        "command": "docker build --platform linux/arm64 -f Dockerfile --build-context container=container -t agentforge/a2a:local .",
        "cwd": "{workspaceRoot}/dist/{projectRoot}/bundle"
      }
    },
    "image-claude": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["image"],
      "options": {
        "command": "docker build --platform linux/arm64 -f Dockerfile --build-arg BASE_IMAGE=agentforge/a2a:local --build-context container=container -t agentforge/a2a-claude:local container",
        "cwd": "{workspaceRoot}/dist/{projectRoot}/bundle/claude"
      }
    },
    "image-strands": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["image"],
      "options": {
        "command": "docker build --platform linux/arm64 -f Dockerfile --build-arg BASE_IMAGE=agentforge/a2a:local --build-context container=container -t agentforge/a2a-strands:local container",
        "cwd": "{workspaceRoot}/dist/{projectRoot}/bundle/strands"
      }
    }
  }
}
