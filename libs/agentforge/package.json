{
  "name": "@beruangai/agentforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "imports": {
    "#core/*": "./src/core/*"
  },
  "exports": {
    "./contract": {
      "@beruangai/source": "./src/core/contract/index.ts",
      "types": "./contract.d.ts",
      "default": "./contract.js"
    },
    "./client": {
      "@beruangai/source": "./src/client/index.ts",
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./temporal": {
      "@beruangai/source": "./src/client/temporal/index.ts",
      "types": "./temporal.d.ts",
      "default": "./temporal.js"
    },
    "./temporal/workflow": {
      "@beruangai/source": "./src/client/temporal/workflow/index.ts",
      "types": "./temporal/workflow.d.ts",
      "default": "./temporal/workflow.js"
    },
    "./agent": {
      "agentforge-agent": {
        "@beruangai/source": "./src/server/harness/index.ts",
        "types": "./agent.d.ts",
        "default": "./agent.js"
      }
    },
    "./server": {
      "agentforge-agent": {
        "@beruangai/source": "./src/server/runtime/index.ts",
        "types": "./server.d.ts",
        "default": "./server.js"
      }
    },
    "./infra": {
      "@beruangai/source": "./src/infra/index.ts",
      "types": "./infra.d.ts",
      "default": "./infra.js"
    },
    "./package.json": "./package.json"
  },
  "generators": "./src/plugin/generators.json",
  "executors": "./src/plugin/executors.json",
  "dependencies": {
    "ohash": "^2.0.12",
    "picomatch": "^4.0.7",
    "semver": "^7.8.5",
    "ts-deepmerge": "^8.0.0"
  },
  "peerDependencies": {
    "@orpc/contract": "2.0.0-beta.39",
    "@orpc/server": "2.0.0-beta.39",
    "zod": "^4.6.5",
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "@a2a-js/sdk": "^1.2.0",
    "express": "^5.2.1",
