    "langsmith": "^0.5.16",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@nx/js": "22.6.1",
    "@nx/vitest": "22.6.1",
    "@nx/workspace": "22.6.1",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/dockerode": "^4.0.1",
    "@types/node": "20.19.9",
    "@vitest/coverage-v8": "4.1.1",
    "eslint-plugin-prettier": "5.5.5",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "3.1.0",
    "nx": "22.6.1",
    "prettier": "3.8.1",
    "tslib": "^2.3.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.58.0",
    "vite": "7.3.1",
    "vitest": "4.1.1"
