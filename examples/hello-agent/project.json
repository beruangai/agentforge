{
  "name": "@beruangai/example-hello-agent",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "examples/hello-agent/files",
  "tags": ["example"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "outputs": ["{workspaceRoot}/dist/examples/hello-agent/typecheck"],
      "options": {
        "command": "tsc -p tsconfig.json",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["biome"],
      "options": {
        "command": "biome check {projectRoot}"
      }
    },
    "lock": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": [
        {
          "projects": ["@beruangai/agentforge"],
          "target": "container-lock"
        }
      ],
      "inputs": [
        "{projectRoot}/files/package.json",
        "{workspaceRoot}/packages/agentforge/container/**/*",
        {
          "dependentTasksOutputFiles": "**/package.json"
        },
        {
          "runtime": "bun --version"
        }
      ],
      "outputs": ["{projectRoot}/files/bun.lock"],
      "options": {
        "command": "bun ../../packages/agentforge/container/workspace-lock.ts --root ../../packages/agentforge/container/workspace/package.json --member agentforge=../../dist/packages/agentforge/bundle --member agentic/agent=files --seed ../../packages/agentforge/container/workspace/bun.lock --out files/bun.lock",
        "cwd": "{projectRoot}"
      }
    },
    "image": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "lock",
        {
          "projects": ["@beruangai/agentforge"],
          "target": "image"
        }
      ],
      "options": {
        "command": "docker build --platform linux/arm64 -t agentforge-examples/hello-agent:local .",
        "cwd": "{projectRoot}"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["image"],
      "options": {
        "command": "vitest run --config vitest.e2e.mts --project=@beruangai/example-hello-agent:e2e:local",
        "cwd": "{projectRoot}",
        "envFile": "{workspaceRoot}/.env.integ.local"
      }
    },
    "e2e-agentcore": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["deploy"],
      "options": {
        "command": "vitest run --config vitest.e2e.mts --project=@beruangai/example-hello-agent:e2e:agentcore",
        "cwd": "{projectRoot}",
        "envFile": "{workspaceRoot}/.env.integ"
      }
    },
    "synth": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "lock",
        {
          "projects": ["@beruangai/agentforge"],
          "target": "image"
        }
      ],
      "outputs": ["{workspaceRoot}/dist/examples/hello-agent/cdk.out"],
      "options": {
        "command": "export AGENTFORGE_BASE_IMAGE_ID=\"$(docker image inspect --format '{{.Id}}' agentforge/a2a-claude:local)\" && export DOCKER_CONFIG=\"$(mktemp -d)\" && trap 'rm -rf \"$DOCKER_CONFIG\"' EXIT && echo \"{}\" > \"$DOCKER_CONFIG/config.json\" && cdk --app \"bun --conditions=@beruangai/source infra/app.ts\" --output ../../dist/examples/hello-agent/cdk.out --no-notices synth --quiet",
        "cwd": "{projectRoot}",
        "envFile": "{workspaceRoot}/.env.integ",
        "env": {
          "CDK_DISABLE_CLI_TELEMETRY": "true"
        }
      }
    },
    "checkov": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["synth"],
      "options": {
        "command": "uvx checkov --config-file {projectRoot}/checkov.yml --directory dist/examples/hello-agent/cdk.out --framework cloudformation --compact"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        "lock",
        {
          "projects": ["@beruangai/agentforge"],
          "target": "image"
        }
      ],
      "outputs": ["{workspaceRoot}/dist/examples/hello-agent/deploy"],
      "options": {
        "command": "export AGENTFORGE_BASE_IMAGE_ID=\"$(docker image inspect --format '{{.Id}}' agentforge/a2a-claude:local)\" && export DOCKER_CONFIG=\"$(mktemp -d)\" && trap 'rm -rf \"$DOCKER_CONFIG\"' EXIT && echo \"{}\" > \"$DOCKER_CONFIG/config.json\" && cdk --app \"bun --conditions=@beruangai/source infra/app.ts\" --output ../../dist/examples/hello-agent/cdk.out --no-notices deploy --require-approval never --outputs-file ../../dist/examples/hello-agent/deploy/outputs.json",
        "cwd": "{projectRoot}",
        "envFile": "{workspaceRoot}/.env.integ",
        "env": {
          "CDK_DISABLE_CLI_TELEMETRY": "true"
        }
      }
    },
    "destroy": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": [
        {
          "projects": ["@beruangai/agentforge"],
          "target": "image"
        }
      ],
      "options": {
        "command": "export AGENTFORGE_BASE_IMAGE_ID=\"$(docker image inspect --format '{{.Id}}' agentforge/a2a-claude:local)\" && cdk --app \"bun --conditions=@beruangai/source infra/app.ts\" --output ../../dist/examples/hello-agent/cdk.out --no-notices destroy --force",
        "cwd": "{projectRoot}",
        "envFile": "{workspaceRoot}/.env.integ",
        "env": {
          "CDK_DISABLE_CLI_TELEMETRY": "true"
        }
      }
    }
  }
}
