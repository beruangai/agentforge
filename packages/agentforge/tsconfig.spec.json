{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node",
      "vitest/importMeta"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "vitest.config.mts",
    "vitest.integ.mts",
    "vitest.e2e.mts",
    "tsdown.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "integ/**/*.ts",
    "e2e/**/*.ts"
  ]
}
