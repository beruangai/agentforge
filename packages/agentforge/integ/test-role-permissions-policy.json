{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AgentCoreInTheTestRegionOnly",
      "Effect": "Allow",
      "Action": "bedrock-agentcore:*",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    },
    {
      "Sid": "PassTheIntegExecutionRoleToAgentCoreOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::913756569129:role/agentforge-integ-agentcore-execution",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "bedrock-agentcore.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadTheIntegExecutionRole",
      "Effect": "Allow",
      "Action": "iam:GetRole",
      "Resource": "arn:aws:iam::913756569129:role/agentforge-integ-agentcore-execution"
    },
    {
      "Sid": "AgentCoreServiceLinkedRolesOnFirstUseInTheAccount",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "iam:AWSServiceName": [
            "bedrock-agentcore.amazonaws.com",
            "*.bedrock-agentcore.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "EcrRepositoriesTheTestsCreate",
      "Effect": "Allow",
      "Action": [
        "ecr:CreateRepository",
        "ecr:DeleteRepository",
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:ListImages",
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchDeleteImage",
        "ecr:TagResource",
        "ecr:UntagResource",
        "ecr:ListTagsForResource"
      ],
      "Resource": "arn:aws:ecr:us-east-2:913756569129:repository/agentforge/integ-*"
    },
    {
      "Sid": "DynamoDbTablesTheTestsCreate",
      "Effect": "Allow",
      "Action": "dynamodb:*",
      "Resource": "arn:aws:dynamodb:us-east-2:913756569129:table/agentforge-integ-*"
    },
    {
      "Sid": "LogsOfThoseRuntimes",
      "Effect": "Allow",
      "Action": [
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "logs:DescribeLogStreams",
        "logs:StartLiveTail",
        "logs:DeleteLogGroup",
        "logs:ListTagsForResource"
      ],
      "Resource": "arn:aws:logs:us-east-2:913756569129:log-group:/aws/bedrock-agentcore/runtimes/agentforge_integ_*"
    },
    {
      "Sid": "S3BucketsTheTestsCreate",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads",
        "s3:GetBucketLocation",
        "s3:GetBucketTagging",
        "s3:PutBucketTagging",
        "s3:TagResource",
        "s3:UntagResource",
        "s3:ListTagsForResource",
        "s3:GetObject",
        "s3:GetObjectAttributes",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::agentforge-integ-*",
        "arn:aws:s3:::agentforge-integ-*/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    },
    {
      "Sid": "ListCallsThatCannotBeScopedToAResource",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken",
        "ecr:DescribeRepositories",
        "dynamodb:ListTables",
        "logs:DescribeLogGroups",
        "tag:GetResources"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "us-east-2"
        }
      }
    }
  ]
}
