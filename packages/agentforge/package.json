{
  "name": "@beruangai/agentforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "imports": {
    "#core/*": "./src/core/*"
  },
  "exports": {
    "./contract": {
      "@beruangai/source": "./src/core/contract/index.ts",
      "types": "./contract.d.ts",
      "default": "./contract.js"
    },
    "./client": {
      "@beruangai/source": "./src/client/index.ts",
      "types": "./client.d.ts",
      "default": "./client.js"
    },
    "./temporal": {
      "@beruangai/source": "./src/client/temporal/index.ts",
      "types": "./temporal.d.ts",
      "default": "./temporal.js"
    },
    "./agent": {
      "agentforge-agent": {
        "@beruangai/source": "./src/server/harness/index.ts",
        "types": "./agent.d.ts",
        "default": "./agent.js"
      }
    },
    "./server": {
      "agentforge-agent": {
        "@beruangai/source": "./src/server/runtime/index.ts",
        "types": "./server.d.ts",
        "default": "./server.js"
      }
    },
    "./infra": {
      "@beruangai/source": "./src/infra/index.ts",
      "types": "./infra.d.ts",
      "default": "./infra.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@orpc/contract": "2.0.0-beta.39",
    "@orpc/server": "2.0.0-beta.39",
    "zod": "^4.6.5",
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "@a2a-js/sdk": "^1.2.0",
    "express": "^5.2.1",
    "@aws-sdk/client-dynamodb": "^3.1138.0",
    "@aws-sdk/client-bedrock-agentcore": "^3.1138.0",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/common": "^1.24.0"
  },
  "peerDependenciesMeta": {
    "@orpc/server": {
      "optional": true
    },
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@a2a-js/sdk": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/client-bedrock-agentcore": {
      "optional": true
    },
    "@temporalio/activity": {
      "optional": true
    },
    "@temporalio/common": {
      "optional": true
    }
  },
  "devDependencies": {
    "@a2a-js/sdk": "catalog:",
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@aws-sdk/client-bedrock-agentcore": "catalog:",
    "@aws-sdk/client-bedrock-agentcore-control": "catalog:",
    "@aws-sdk/client-cloudwatch-logs": "catalog:",
    "@aws-sdk/client-dynamodb": "catalog:",
    "@aws-sdk/client-ecr": "catalog:",
    "@aws-sdk/client-iam": "catalog:",
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/client-sts": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "@orpc/shared": "catalog:",
    "@temporalio/activity": "catalog:",
    "@temporalio/client": "catalog:",
    "@temporalio/common": "catalog:",
    "@temporalio/testing": "catalog:",
    "@temporalio/worker": "catalog:",
    "@temporalio/workflow": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "express": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  }
}
