# What `serve-hello-agent` declares to the agent beside its secrets: the
# bucket its filesystem uses in the local store, as AgentRuntime's
# `filesystems` names it when deployed, and the journal's host repository,
# which serve creates empty on first use, as it has no remote.
AGENTFORGE_FILESYSTEM_BUCKETS={"notebook":"strands-smoke-notebook"}
AGENTFORGE_FILESYSTEM_REPOSITORIES={"journal":".agentforge/repositories/strands-smoke-journal.git"}
