# What `serve-hello-agent` declares to the agent beside its secrets: the
# buckets its filesystems use in the local store, as AgentRuntime's
# `filesystems` names them when deployed; and the journal's repository, a
# host directory serve creates empty — it has no remote — as AgentRuntime's
# `repositories` would name a remote.
AGENTFORGE_FILESYSTEM_BUCKETS={"notebook":"smoke-coverage-notebook","memories":"smoke-coverage-memories"}
AGENTFORGE_FILESYSTEM_REPOSITORIES={"journal":".agentforge/repositories/smoke-coverage-journal.git"}
