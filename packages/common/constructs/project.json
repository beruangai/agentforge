{
  "name": "@beruangai/common-constructs",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/common/constructs/src",
  "projectType": "library",
  "tags": [],
  "metadata": {
    "generator": "ts#project"
  },
  "targets": {
    "assemble": {
      "dependsOn": [
        "compile",
        "@beruangai/golden-kata:assemble",
        "@beruangai/smoke-coverage:assemble",
        "@beruangai/golden-kata-workflows:assemble"
      ]
    },
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["lint", "compile", "test"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/packages/common/constructs",
        "main": "packages/common/constructs/src/index.ts",
        "tsConfig": "packages/common/constructs/tsconfig.lib.json",
        "assets": ["packages/common/constructs/*.md"]
      }
    },
    "compile": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}/tsc"],
      "options": {
        "command": "tsc --build tsconfig.lib.json",
        "cwd": "{projectRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["biome"],
      "options": {
        "command": "biome format {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome format --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["biome"],
      "dependsOn": ["format"],
      "options": {
        "command": "biome lint {projectRoot}"
      },
      "configurations": {
        "fix": {
          "command": "biome check --write {projectRoot}"
        },
        "skip-lint": {
          "command": "node -e \"\""
        }
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{options.reportsDirectory}"],
      "options": {
        "reportsDirectory": "coverage/packages/common/constructs"
      }
    }
  }
}
